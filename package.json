{
  "name": "ring-road",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prototype": "node scripts/serve.mjs",
    "context": "node scripts/context.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:art": "node scripts/check-diorama-assets.mjs",
    "check:context": "node scripts/check-context-budget.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:repo && npm run check:art && npm run check:skin-art && npm run check:visual-audit && npm run check:context",
    "visual:audit": "node scripts/visual-viewport-audit.mjs",
    "check:skin-art": "node scripts/check-reference-skin.mjs",
    "check:visual-audit": "node --check scripts/visual-viewport-audit.mjs",
    "build:android": "tsc --noEmit && vite build --base=./"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "@capacitor/core": "^7.4.0",
    "@capacitor/android": "^7.4.0"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.2",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "@capacitor/cli": "^7.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
